[
  {
    "description": "Location-independent identifier",
    "compatibility": "6,<=7",
    "schema": {
      "allOf": [
        {
          "$ref": "#foo"
        }
      ],
      "definitions": {
        "A": {
          "$id": "#foo",
          "type": "integer"
        }
      }
    },
    "tests": [
      {
        "data": 1,
        "description": "match",
        "valid": true
      },
      {
        "data": "a",
        "description": "mismatch",
        "valid": false
      }
    ]
  },
  {
    "description": "Location-independent identifier (id)",

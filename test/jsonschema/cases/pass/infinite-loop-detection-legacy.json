[
  {
    "description": "evaluating the same schema location against the same data location twice is not a sign of an infinite loop (extends)",
    "compatibility": "=3",
    "schema": {
      "definitions": {
        "int": {
          "type": "integer"
        }
      },
      "properties": {
        "foo": {
          "$ref": "#/definitions/int"
        }
      },
      "extends": {
        "additionalProperties": {
          "$ref": "#/definitions/int"
        }
      }
    },
    "tests": [
      {
        "description": "passing case",
        "data": {
          "foo": 1
        },
        "valid": true
      },
      {
        "description": "failing case",
        "data": {
          "foo": "a string"
        },
        "valid": false
      }
    ]
  },
  {
    "description": "evaluating the same schema location against the same data location twice is not a sign of an infinite loop",
    "compatibility": "4,<=7",
    "schema": {
      "definitions": {

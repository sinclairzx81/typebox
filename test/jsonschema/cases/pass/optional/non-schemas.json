  {
    "description": "reference of a root arbitrary keyword",
    "compatibility": "2019,<=2020",
    "schema": {
      "unknown-keyword": {
        "type": "integer"
      },
      "properties": {
        "bar": {
          "$ref": "#/unknown-keyword"
        }
      }
    },
    "tests": [
      {
        "description": "match",
        "data": {
          "bar": 3
        },
        "valid": true
      },
      {
        "description": "mismatch",
        "data": {
          "bar": true
        },
        "valid": false
      }
    ]
  },

        {
          "$ref": "#/then"
        }
      ],
      "then": {
        "type": "integer"
      }
    },
    "tests": [
      {
        "description": "a non-integer is invalid due to the $ref",
        "data": "foo",
        "valid": false
      },
      {
        "description": "an integer is valid",
        "data": 12,
        "valid": true
      }
    ]
  },
  {
    "description": "ref to else",
    "compatibility": "7",
    "schema": {
      "allOf": [
        {
          "$ref": "#/else"
        }
      ],
      "else": {
        "type": "integer"
      }
    },
    "tests": [
      {
        "description": "a non-integer is invalid due to the $ref",
        "data": "foo",
        "valid": false
      },
      {
        "description": "an integer is valid",
        "data": 12,
        "valid": true
      }
    ]
  },
  {
    "description": "empty tokens in $ref json-pointer",
    "compatibility": "2019",
    "schema": {
      "$defs": {
        "": {
          "$defs": {
            "": {
              "type": "number"
            }
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs//$defs/"
        }
      ]
    },
    "tests": [
      {
        "description": "number is valid",
        "data": 1,
        "valid": true
      },
      {
        "description": "non-number is invalid",
        "data": "a",
        "valid": false
      }
    ]
  },
  {
    "description": "remote ref",
    "schema": {
      "$ref": "http://localhost:1234/integer.json"
    },
    "compatibility": "3",
    "externalSchemas": {
      "http://localhost:1234/integer.json": {
        "type": "integer"
      }
    },
    "tests": [
      {
        "description": "remote ref valid",
        "data": 1,
        "valid": true
      },
      {
        "description": "remote ref invalid",
        "data": "a",
        "valid": false
      }
    ]
  },
  {
    "description": "fragment within remote ref",
    "compatibility": "2019",
    "schema": {
      "$ref": "http://localhost:1234/subSchemas.json#/$defs/integer"
    },
    "externalSchemas": {
      "http://localhost:1234/subSchemas.json": {
        "$defs": {
          "integer": {
            "type": "integer"
          }
        }
      }
    },
    "tests": [
      {
        "description": "remote fragment valid",
        "data": 1,
        "valid": true
      },
      {
        "description": "remote fragment invalid",
        "data": "a",
        "valid": false
      }
    ]
  },
  {
    "description": "ref within remote ref",
    "compatibility": "2019",
    "schema": {
      "$ref": "http://localhost:1234/subSchemas.json#/$defs/refToInteger"
    },
    "externalSchemas": {
      "http://localhost:1234/subSchemas.json": {
        "$defs": {
          "integer": {
            "type": "integer"
          },
          "refToInteger": {
            "$ref": "#/$defs/integer"
          }
        }
      }
    },
    "tests": [
      {
        "description": "ref within ref valid",
        "data": 1,
        "valid": true
      },
      {
        "description": "ref within ref invalid",
        "data": "a",
        "valid": false
      }
    ]
  },
  {
    "description": "root ref in remote ref",
    "compatibility": "2019",
    "schema": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "http://localhost:1234/name-defs.json#/$defs/orNull"
        }
      }
    },
    "externalSchemas": {
      "http://localhost:1234/name-defs.json": {
        "$defs": {
          "orNull": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#"
              }
            ]
          }
        },
        "type": "string"
      }
    },
    "tests": [
      {
        "description": "string is valid",
        "data": {
          "name": "foo"
        },
        "valid": true
      },
      {
        "description": "null is valid",
        "data": {
          "name": null
        },
        "valid": true
      },
      {
        "description": "object is invalid",
        "data": {
          "name": {
            "name": null
          }
        },
        "valid": false
      }
    ]
  },
  {
    "description": "remote ref with ref to defs",
    "compatibility": "2019",
    "schema": {
      "$ref": "http://localhost:1234/ref-and-defs.json"
    },
    "externalSchemas": {
      "http://localhost:1234/ref-and-defs.json": {
        "$defs": {
          "inner": {
            "properties": {
              "bar": {
                "type": "string"
              }
            }
          }
        },
        "$ref": "#/$defs/inner"
      }
    },
    "tests": [
      {
        "description": "invalid",
        "data": {
          "bar": 1
        },
        "valid": false
      },
      {
        "description": "valid",
        "data": {
          "bar": "a"
        },
        "valid": true
      }
    ]
  }
]
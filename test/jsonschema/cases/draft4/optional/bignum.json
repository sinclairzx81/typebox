[
  {
    "description": "integer",
    "schema": {
      "type": "integer"
    },
    "tests": [
      {
        "description": "a bignum is an integer",
        "data": 1.2345678910111214e+52,
        "valid": true
      },
      {
        "description": "a negative bignum is an integer",
        "data": -1.2345678910111214e+52,
        "valid": true
      }
    ]
  },
  {
    "description": "number",
    "schema": {
      "type": "number"
    },
    "tests": [
      {
        "description": "a bignum is a number",
        "data": 9.824928374923492e+52,
        "valid": true
      },
      {
        "description": "a negative bignum is a number",
        "data": -9.824928374923492e+52,
        "valid": true
      }
    ]
  },
  {
    "description": "string",
    "schema": {
      "type": "string"
    },
    "tests": [
      {
        "description": "a bignum is not a string",
        "data": 9.824928374923492e+52,
        "valid": false
      }
    ]
  },
  {
    "description": "maximum integer comparison",
    "schema": {
      "maximum": 18446744073709552000
    },
    "tests": [
      {
        "description": "comparison works for high numbers",
        "data": 18446744073709552000,
        "valid": true
      }
    ]
  },
  {
    "description": "minimum integer comparison",
    "schema": {
      "minimum": -18446744073709552000
    },
    "tests": [
      {
        "description": "comparison works for very negative numbers",
        "data": -18446744073709552000,
        "valid": true
      }
    ]
  },
  {
    "description": "multipleOf with integers above 2^53",
    "comment": "Both instances are exact as doubles, but dividing by 3 rounds the quotient to an integer, so the check must not rely on the quotient",
    "schema": {
      "multipleOf": 3
    },
    "tests": [
      {
        "description": "3e20 is multiple of 3",
        "data": 300000000000000000000,
        "valid": true
      },
      {
        "description": "1e20 is not multiple of 3",
        "data": 100000000000000000000,
        "valid": false
      }
    ]
  }
]
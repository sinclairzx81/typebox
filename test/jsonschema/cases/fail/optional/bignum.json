[
  {
    "description": "maximum integer comparison",
    "schema": {
      "maximum": 18446744073709552000
    },
    "tests": [
      {
        "description": "just above the maximum is invalid",
        "data": 18446744073709552000,
        "valid": false
      }
    ]
  },
  {
    "description": "float comparison with high precision (boolean)",
    "compatibility": "<=4",
    "schema": {
      "maximum": 9.727837981879871e+26,
      "exclusiveMaximum": true
    },
    "tests": [
      {
        "description": "comparison works for high numbers",
        "data": 9.727837981879871e+26,
        "valid": false
      }
    ]
  },
  {
    "description": "float comparison with high precision",
    "compatibility": "6",
    "schema": {
      "exclusiveMaximum": 9.727837981879871e+26
    },
    "tests": [
      {
        "description": "below the exclusive maximum is valid",
        "data": 9.727837981879871e+26,
        "valid": true
      }
    ]
  },
  {
    "description": "minimum integer comparison",
    "schema": {
      "minimum": -18446744073709552000
    },
    "tests": [
      {
        "description": "just below the minimum is invalid",
        "data": -18446744073709552000,
        "valid": false
      }
    ]
  },
  {
    "description": "float comparison with high precision on negative numbers (boolean)",
    "compatibility": "<=4",
    "schema": {
      "minimum": -9.727837981879871e+26,
      "exclusiveMinimum": true
    },
    "tests": [
      {
        "description": "comparison works for very negative numbers",
        "data": -9.727837981879871e+26,
        "valid": false
      }
    ]
  },
  {
    "description": "float comparison with high precision on negative numbers",
    "compatibility": "6",
    "schema": {
      "exclusiveMinimum": -9.727837981879871e+26
    },
    "tests": [
      {
        "description": "above the exclusive minimum is valid",
        "data": -9.727837981879871e+26,
        "valid": true
      }
    ]
  },
  {
    "description": "enum comparison with high precision",
    "schema": {
      "enum": [
        0.12345678912345678
      ]
    },
    "tests": [
      {
        "description": "a slightly smaller decimal is invalid",
        "data": 0.12345678912345678,
        "valid": false
      },
      {
        "description": "a slightly larger decimal is invalid",
        "data": 0.12345678912345678,
        "valid": false
      }
    ]
  },
  {
    "description": "const comparison with high precision",
    "compatibility": "6",
    "schema": {
      "const": 0.12345678912345678
    },
    "tests": [
      {
        "description": "a slightly smaller decimal is invalid",
        "data": 0.12345678912345678,
        "valid": false
      },
      {
        "description": "a slightly larger decimal is invalid",
        "data": 0.12345678912345678,
        "valid": false
      }
    ]
  },
  {
    "description": "uniqueItems comparison with high precision",
    "schema": {
      "uniqueItems": true
    },
    "tests": [
      {
        "description": "distinct high-precision decimals are unique",
        "data": [
          0.12345678912345678,
          0.12345678912345678
        ],
        "valid": true
      },
      {
        "description": "arrays containing distinct decimals are unique",
        "data": [
          [
            0.12345678912345678
          ],
          [
            0.12345678912345678
          ]
        ],
        "valid": true
      },
      {
        "description": "objects containing distinct decimals are unique",
        "data": [
          {
            "value": 0.12345678912345678
          },
          {
            "value": 0.12345678912345678
          }
        ],
        "valid": true
      }
    ]
  },
  {
    "description": "divisibleBy with integers above 2^53",
    "comment": "Both instances are exact as doubles, but dividing by 3 rounds the quotient to an integer, so the check must not rely on the quotient",
    "compatibility": "=3",
    "schema": {
      "divisibleBy": 3
    },
    "tests": [
      {
        "description": "1e20 is not divisible by 3",
        "data": 100000000000000000000,
        "valid": false
      }
    ]
  }
]
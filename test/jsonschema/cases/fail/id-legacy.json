[
  {
    "description": "base URI change",
    "compatibility": "3,<=4",
    "schema": {
      "id": "http://localhost:1234/",
      "items": {
        "id": "baseUriChange/",
        "items": {
          "$ref": "folderInteger.json"
        }
      }
    },
    "externalSchemas": {
      "http://localhost:1234/baseUriChange/folderInteger.json": {
        "type": "integer"
      }
    },
    "tests": [
      {
        "description": "base URI change ref valid",
        "data": [
          [
            1
          ]
        ],
        "valid": true
      }
    ]
  },
  {
    "description": "base URI change - change folder (id)",
    "compatibility": "3,<=4",
    "schema": {
      "id": "http://localhost:1234/scope_change_defs1.json",
      "type": "object",
      "properties": {
        "list": {
          "$ref": "#/definitions/baz"
        }
      },
      "definitions": {
        "baz": {
          "id": "baseUriChangeFolder/",
          "type": "array",
          "items": {
            "$ref": "folderInteger.json"
          }
        }
      }
    },
    "externalSchemas": {
      "http://localhost:1234/baseUriChangeFolder/folderInteger.json": {
        "type": "integer"
      }
    },
    "tests": [
      {
        "description": "number is valid",
        "data": {
          "list": [
            1
          ]
        },
        "valid": true
      }
    ]
  },
  {
    "description": "base URI change - change folder in subschema (id)",
    "compatibility": "3,<=4",
    "schema": {
      "id": "http://localhost:1234/scope_change_defs2.json",
      "type": "object",
      "properties": {
        "list": {
          "$ref": "#/definitions/baz/definitions/bar"
        }
      },
      "definitions": {
        "baz": {
          "id": "baseUriChangeFolderInSubschema/",
          "definitions": {
            "bar": {
              "type": "array",
              "items": {
                "$ref": "folderInteger.json"
              }
            }
          }
        }
      }
    },
    "externalSchemas": {
      "http://localhost:1234/baseUriChangeFolderInSubschema/folderInteger.json": {
        "type": "integer"
      }
    },
    "tests": [
      {
        "description": "number is valid",
        "data": {
          "list": [
            1
          ]
        },
        "valid": true
      }
    ]
  },
  {
    "description": "$ref prevents a sibling id from changing the base uri",
    "compatibility": "3,<=4",
    "schema": {
      "id": "http://localhost:1234/sibling_id/base/",
      "definitions": {
        "foo": {
          "id": "http://localhost:1234/sibling_id/foo.json",
          "type": "string"
        },
        "base_foo": {
          "$comment": "this canonical uri is http://localhost:1234/sibling_id/base/foo.json",
          "id": "foo.json",
          "type": "number"
        }
      },
      "properties": {
        "foo": {
          "$comment": "$ref resolves to http://localhost:1234/sibling_id/base/foo.json, not http://localhost:1234/sibling_id/foo.json",
          "id": "http://localhost:1234/sibling_id/",
          "$ref": "foo.json"
        }
      }
    },
    "tests": [
      {
        "description": "$ref resolves to /definitions/base_foo, data validates",
        "data": {
          "foo": 1
        },
        "valid": true
      }
    ]
  },
  {
    "description": "refs with relative uris and defs (id)",
    "compatibility": "=4",
    "schema": {
      "id": "http://example.com/schema-relative-uri-defs1.json",
      "properties": {
        "foo": {
          "id": "schema-relative-uri-defs2.json",
          "definitions": {
            "inner": {
              "properties": {
                "bar": {
                  "type": "string"
                }
              }
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/inner"
            }
          ]
        }
      },
      "allOf": [
        {
          "$ref": "schema-relative-uri-defs2.json"
        }
      ]
    },
    "tests": [
      {
        "description": "valid on both fields",
        "data": {
          "foo": {
            "bar": "a"
          },
          "bar": "a"
        },
        "valid": true
      }
    ]
  },
  {
    "description": "relative refs with absolute uris and defs (id)",
    "compatibility": "=4",
    "schema": {
      "id": "http://example.com/schema-refs-absolute-uris-defs1.json",
      "properties": {
        "foo": {
          "id": "http://example.com/schema-refs-absolute-uris-defs2.json",
          "definitions": {
            "inner": {
              "properties": {
                "bar": {
                  "type": "string"
                }
              }
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/inner"
            }
          ]
        }
      },
      "allOf": [
        {
          "$ref": "schema-refs-absolute-uris-defs2.json"
        }
      ]
    },
    "tests": [
      {
        "description": "valid on both fields",
        "data": {
          "foo": {
            "bar": "a"
          },
          "bar": "a"
        },
        "valid": true
      }
    ]
  },
  {
    "description": "id must be resolved against nearest parent, not just immediate parent",
    "compatibility": "3,<=4",
    "schema": {
      "id": "http://example.com/a.json",
      "definitions": {
        "x": {
          "id": "http://example.com/b/c.json",
          "items": {
            "definitions": {
              "y": {
                "id": "d.json",
                "type": "number"
              }
            }
          }
        }
      },
      "properties": {
        "foo": {
          "$ref": "http://example.com/b/d.json"
        }
      }
    },
    "tests": [
      {
        "description": "number is valid",
        "data": {
          "foo": 1
        },
        "valid": true
      }
    ]
  },
  {
    "description": "simple URN base URI with $ref via the URN (id)",
    "compatibility": "3,<=4",
    "schema": {
      "$comment": "URIs do not have to have HTTP(s) schemes",
      "id": "urn:uuid:deadbeef-1234-ffff-ffff-4321feebdaed",
      "minimum": 30,
      "properties": {
        "foo": {
          "$ref": "urn:uuid:deadbeef-1234-ffff-ffff-4321feebdaed"
        }
      }
    },
    "tests": [
      {
        "description": "valid under the URN IDed schema",
        "data": {
          "foo": 37
        },
        "valid": true
      }
    ]
  },
  {
    "description": "simple tag URI base URI with $ref via the tag URI (id)",
    "compatibility": "3,<=4",
    "schema": {
      "$comment": "URIs do not have to have HTTP(s) schemes",
      "id": "tag:foo.example,2025:bar/baz",
      "minimum": 30,
      "properties": {
        "foo": {
          "$ref": "tag:foo.example,2025:bar/baz"
        }
      }
    },
    "tests": [
      {
        "description": "valid under the tag URI IDed schema",
        "data": {
          "foo": 37
        },
        "valid": true
      }
    ]
  },
  {
    "description": "simple base URI using an arbitrary URI scheme with $ref to that URI (id)",
    "compatibility": "3,<=4",
    "comment": "foo is a made up scheme. Any URI scheme is allowed in a base URI, not only well known ones like http, urn or tag, so implementations need to support arbitrary schemes rather than special casing the ones they know.",
    "schema": {
      "$comment": "URIs do not have to have HTTP(s) schemes",
      "id": "foo:bar/baz",
      "minimum": 30,
      "properties": {
        "foo": {
          "$ref": "foo:bar/baz"
        }
      }
    },
    "tests": [
      {
        "description": "valid under the arbitrary scheme IDed schema",
        "data": {
          "foo": 37
        },
        "valid": true
      }
    ]
  },
  {
    "description": "ref with absolute-path-reference (id)",
    "compatibility": "3,<=4",
    "schema": {
      "id": "http://example.com/ref/absref.json",
      "definitions": {
        "a": {
          "id": "http://example.com/ref/absref/foobar.json",
          "type": "number"
        },
        "b": {
          "id": "http://example.com/absref/foobar.json",
          "type": "string"
        }
      },
      "properties": {
        "foo": {
          "$ref": "/absref/foobar.json"
        }
      }
    },
    "tests": [
      {
        "description": "a string is valid",
        "data": {
          "foo": "foo"
        },
        "valid": true
      }
    ]
  },
  {

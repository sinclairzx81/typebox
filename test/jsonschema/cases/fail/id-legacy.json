      }
    ]
  },
  {
    "description": "remote HTTP ref with nested absolute ref (id)",
    "compatibility": "3,<=4",
    "schema": {
      "$ref": "http://localhost:1234/nested-absolute-ref-to-string.json"
    },
    "externalSchemas": {
      "http://localhost:1234/nested-absolute-ref-to-string.json": {

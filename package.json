{
  "name": "typebox",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "test/common"
  ],
  "scripts": {
    "bench": "node tasks.ts bench",
    "build": "node tasks.ts build",
    "clean": "node tasks.ts clean",
    "check": "node tasks.ts check",
    "format": "node tasks.ts format",
    "lint": "node tasks.ts lint",
    "compliance": "node tasks.ts compliance",
    "local": "node tasks.ts local",
    "metrics": "node tasks.ts metrics",
    "publish": "node tasks.ts publish",
    "range": "node tasks.ts range",
    "start": "node tasks.ts start",
    "syntax": "node tasks.ts syntax",
    "spec": "node tasks.ts spec",
    "test": "node tasks.ts test",
    "fast": "node tasks.ts fast",
    "report": "node tasks.ts report",
    "challenge": "node tasks.ts challenge",
    "turing": "node tasks.ts turing",
    "automata": "node tasks.ts automata",
    "peano": "node tasks.ts peano",
    "website": "node tasks.ts website"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./compile": {
      "types": "./src/compile/index.ts",
      "import": "./src/compile/index.ts",
      "default": "./src/compile/index.ts"
    },
    "./error": {
      "types": "./src/error/index.ts",
      "import": "./src/error/index.ts",
      "default": "./src/error/index.ts"
    },
    "./format": {
      "types": "./src/format/index.ts",
      "import": "./src/format/index.ts",
      "default": "./src/format/index.ts"
    },
    "./guard": {
      "types": "./src/guard/index.ts",
      "import": "./src/guard/index.ts",
      "default": "./src/guard/index.ts"
    },
    "./module": {
      "types": "./src/module/index.ts",
      "import": "./src/module/index.ts",
      "default": "./src/module/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./system": {
      "types": "./src/system/index.ts",
      "import": "./src/system/index.ts",
      "default": "./src/system/index.ts"
    },
    "./type": {
      "types": "./src/type/index.ts",
      "import": "./src/type/index.ts",
      "default": "./src/type/index.ts"
    },
    "./value": {
      "types": "./src/value/index.ts",
      "import": "./src/value/index.ts",
      "default": "./src/value/index.ts"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@react-three/fiber": "9.3.0",
    "@sinclair/parsebox": "0.11.6",
    "@sinclair/typebox": "0.34.52",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "ajv": "8.20.0",
    "deno": "2.9.6",
    "esbuild": "0.28.2",
    "marked": "16.2.1",
    "prismjs": "1.30.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.4",
    "three": "0.180.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "deno@2.9.6": true,
    "esbuild@0.28.2": true
  }
}
